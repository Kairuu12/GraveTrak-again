# Copy values into the backend process environment; Django does not load this file automatically.
# Local development defaults to SQLite when DJANGO_DEBUG=1 and DB_ENGINE is unset.
DJANGO_DEBUG=1
DB_ENGINE=sqlite

# To use PostgreSQL, set DB_ENGINE=postgresql and provide all required values.
# DB_ENGINE=postgresql
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=replace_with_a_secret
# DB_HOST=your_database_host
# DB_PORT=5432

# Render backend environment (set these in its dashboard, not in frontend code).
# RENDER and RENDER_EXTERNAL_HOSTNAME are supplied by Render automatically.
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=generate_a_random_secret_of_at_least_50_characters
# DJANGO_ALLOWED_HOSTS=gravetrak-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://gravetrak-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://gravetrak-frontend.onrender.com
# DB_ENGINE=postgresql
# Supply DB_NAME / DB_USER / DB_PASSWORD / DB_HOST / DB_PORT above.
# This project uses the separate DB_* values, not DATABASE_URL.
# With a persistent disk mounted at /var/data:
# DJANGO_MEDIA_ROOT=/var/data/media
# Without a disk uploads are temporary and disappear on restart/redeploy.
